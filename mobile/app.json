{
  "expo": {
    "name": "EchoMind AI",
    "slug": "echomind-ai",
    "version": "1.0.0",
    "scheme": "echomind",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.aryanmanhas.echomind",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-calendar",
        {
          "calendarPermission": "EchoMind needs access to your calendar to schedule reminders.",
          "remindersPermission": "EchoMind needs access to your reminders to manage tasks."
        }
      ],
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "EchoMind needs access to your microphone to transcribe your voice."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.23",
            "minSdkVersion": 24
          }
        }
      ],
      "./plugins/withAndroidReleaseFixes.js"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ddf26587-11cf-4ba2-9b5b-0c62a09b5a59"
      }
    },
    "owner": "aryan3369"
  }
}

