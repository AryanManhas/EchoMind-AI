# EchoMind root environment example
# Copy values into the relevant local env files. Do not commit real secrets.

# Server
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:3000
PROCESS_TYPE=web

# Feature gates
ENABLE_DATABASE=false
ENABLE_REDIS=false
ENABLE_QUEUES=false
ENABLE_WEBSOCKET=true
ENABLE_SCHEDULER=false
DEMO_MODE=true

# PostgreSQL + pgvector
DATABASE_URL=postgresql://postgres:password@localhost:5433/echomind?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5433/echomind?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# AI and STT
GEMINI_API_KEY=replace_with_gemini_api_key
GOOGLE_API_KEY=replace_with_gemini_api_key
DEEPGRAM_API_KEY=replace_with_deepgram_api_key
WHISPER_URL=http://localhost:8000

# JWT auth
JWT_SECRET=replace_with_64_character_random_hex
JWT_REFRESH_SECRET=replace_with_64_character_random_hex
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Logging
LOG_LEVEL=info

# Google Calendar OAuth, optional
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/callback

# Next.js web client, usually client/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Expo mobile app, usually mobile/.env
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WS_URL=ws://localhost:8080
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_GEMINI_API_KEY=replace_with_public_demo_key_only
EXPO_PUBLIC_PICOVOICE_ACCESS_KEY=replace_with_picovoice_access_key

# Optional context extractor service
HOST=0.0.0.0
ENVIRONMENT=development
ELASTICSEARCH_URL=http://localhost:9200
MODEL_NAME=bert-base-uncased
USE_QUANTIZATION=true
MAX_SEQ_LENGTH=512
API_KEY=replace_with_internal_context_service_key

# Local build/tooling variables, normally supplied by the OS or hosting platform
ANDROID_HOME=C:\Users\YourUser\AppData\Local\Android\Sdk
ANDROID_SDK_ROOT=C:\Users\YourUser\AppData\Local\Android\Sdk
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17
LOCALAPPDATA=C:\Users\YourUser\AppData\Local
HOSTNAME=localhost

# Optional Next.js/Vercel platform variables, normally injected by the host
VERCEL_ENV=development
VERCEL_URL=localhost:3000
VERCEL_BRANCH_URL=localhost:3000
VERCEL_PROJECT_PRODUCTION_URL=localhost:3000
NEXT_OTEL_FETCH_DISABLED=1
NEXT_OTEL_PERFORMANCE_PREFIX=echomind
NEXT_OTEL_VERBOSE=0
NEXT_PRIVATE_RESPONSE_CACHE_MAX_SIZE=0
NEXT_PRIVATE_RESPONSE_CACHE_TTL=0
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_next_server_actions_key_if_required
KEEP_ALIVE_TIMEOUT=65000
